#, php-format
msgid "%d Threads"
msgstr "%d trådar"

#: setup.php
msgid "Maximum Run Time"
msgstr "Maximal körtid"

#: setup.php
msgid "If the Parallel Query does not finish in this time, exit."
msgstr "Om den parallella frågan inte har slutförts inom den här tiden avbryts den."

#: setup.php
msgid "Cached Data Time to Live"
msgstr "Livslängd för cachade data"

#: setup.php
msgid "How long should FlowView hold onto Cached Query results before purging them?"
msgstr "Hur länge ska FlowView behålla cachelagrade frågeresultat innan de rensas?"

