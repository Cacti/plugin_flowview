[Unit]
Description=FlowView Parallel Query Service
Documentation=https://github.com/Cacti/plugin_flowview
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
# Dedicated unprivileged user; see README for the DB grants it needs.
User=flowview
Group=flowview
RuntimeDirectory=flowview
RuntimeDirectoryMode=0750

# The config file holds the database credentials; keep it root:flowview 0640.
ExecStart=/usr/local/bin/flowview-query -config /etc/flowview/flowview-query.json
Restart=on-failure
RestartSec=3

# Hardening: the service only needs loopback networking and its runtime dir.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/run/flowview
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
